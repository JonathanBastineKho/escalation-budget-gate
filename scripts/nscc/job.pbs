#!/bin/bash
#PBS -N egate
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -uo pipefail
cd "$PBS_O_WORKDIR" || exit 1

MODEL="${MODEL:-cyankiwi/Qwen3.8-27B-AWQ-INT4}"
REVIEWER_MODEL="${REVIEWER_MODEL:-$MODEL}"
REVIEWER_MEM="${REVIEWER_MEM:-0.60}"
AGENT_MEM="${AGENT_MEM:-0.34}"
ARMS="${ARMS:-full_approve:inf full_escalate:0 full_escalate:1 full_escalate:3 full_escalate:inf cascade:0 cascade:1 cascade:3 cascade:inf}"
ATTACK="${ATTACK:-}"
INJ="${INJ:-}"
USER_TASKS="${USER_TASKS:-}"
SEED="${SEED:-0}"
EXTRA="${EXTRA:-}"
SCRATCH_DIR="${SCRATCH_DIR:-/scratch/users/ntu/jonatha4}"

export PATH="$HOME/vllm-env/bin:$PATH"
export HF_HOME="$SCRATCH_DIR/hf"
export HF_HUB_OFFLINE=1
export VLLM_USE_FLASHINFER_SAMPLER=0
export OPENAI_BASE_URL=http://localhost:8000/v1
export OPENAI_API_KEY=EMPTY

JOB="${PBS_JOBID%%.*}"
LOGDIR=results/nscc
mkdir -p "$LOGDIR"

echo "job $JOB on $(hostname), agent $MODEL, reviewer $REVIEWER_MODEL"
echo "arms: $ARMS"
echo "attack: ${ATTACK:-none}  injection tasks: ${INJ:-all}  user tasks: ${USER_TASKS:-all}"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader

serve() {  # model port memory-share log
  # Ports stay fixed because endpoint URLs are part of the comparison ID. Another job
  # on this node already holding the port would silently serve this job's requests.
  if curl -sf "localhost:$2/v1/models" > /dev/null; then
    echo "port $2 is already served by another job on $(hostname); resubmit this job"
    exit 3
  fi
  local parser=qwen3_xml
  [[ "$1" == *Qwen3.5* ]] && parser=qwen3_coder
  # Servers stay on the job's first GPU, so a second one is left free for Decision-2
  # (--decision-device cuda:1). Works with one GPU too.
  local first_gpu="${CUDA_VISIBLE_DEVICES:-0}"
  CUDA_VISIBLE_DEVICES="${first_gpu%%,*}" vllm serve "$1" \
    --port "$2" \
    --max-model-len 32768 \
    --max-num-seqs 32 \
    --limit-mm-per-prompt '{"image":0,"video":0}' \
    --gpu-memory-utilization "$3" \
    --seed 0 \
    --reasoning-parser qwen3 \
    --enable-auto-tool-choice --tool-call-parser "$parser" \
    > "$4" 2>&1 &
  LAST_PID=$!
  SERVER_PIDS+=("$LAST_PID")
}

wait_ready() {  # port log
  for _ in $(seq 1 180); do
    if ! kill -0 "$LAST_PID" 2>/dev/null; then
      echo "vLLM on port $1 exited during startup"; tail -40 "$2"; return 1
    fi
    curl -sf "localhost:$1/v1/models" > /dev/null && kill -0 "$LAST_PID" 2>/dev/null && return 0
    sleep 10
  done
  echo "vLLM on port $1 not ready"; tail -40 "$2"; return 1
}

SERVER_PIDS=()
trap 'kill "${SERVER_PIDS[@]}" 2>/dev/null' EXIT
REVIEWER_ARGS=()
if [ "$REVIEWER_MODEL" = "$MODEL" ]; then
  serve "$MODEL" 8000 0.92 "$LOGDIR/vllm_$JOB.log"
  wait_ready 8000 "$LOGDIR/vllm_$JOB.log" || exit 1
else
  serve "$REVIEWER_MODEL" 8001 "$REVIEWER_MEM" "$LOGDIR/vllm_reviewer_$JOB.log"
  wait_ready 8001 "$LOGDIR/vllm_reviewer_$JOB.log" || exit 1
  serve "$MODEL" 8000 "$AGENT_MEM" "$LOGDIR/vllm_agent_$JOB.log"
  wait_ready 8000 "$LOGDIR/vllm_agent_$JOB.log" || exit 1
  export REVIEWER_BASE_URL=http://localhost:8001/v1
  REVIEWER_ARGS=(--reviewer-model "$REVIEWER_MODEL")
fi
echo "vLLM ready"
grep -h "KV cache" "$LOGDIR"/vllm*_"$JOB".log | tail -4

if ! .venv/bin/python -c "
import os, openai
for url, model in {('http://localhost:8000/v1', '$MODEL'),
                   (os.environ.get('REVIEWER_BASE_URL', 'http://localhost:8000/v1'), '$REVIEWER_MODEL')}:
    m = openai.OpenAI(base_url=url).chat.completions.create(
        model=model, messages=[{'role': 'user', 'content': 'say ok'}], max_tokens=20)
    print('probe', model, repr(m.choices[0].message.content))
"; then
  echo "probe request failed"; exit 1
fi

PIDS=()
NAMES=()
for ARM in $ARMS; do
  POLICY="${ARM%%:*}"
  REST="${ARM#*:}"
  K="${REST%%:*}"
  ARM_ATTACK="$ATTACK"
  [[ "$REST" == *:* ]] && ARM_ATTACK="${REST#*:}"
  NAME="${POLICY}_k${K}_s${SEED}${ARM_ATTACK:+_$ARM_ATTACK}"
  ARGS=(--model "$MODEL" ${REVIEWER_ARGS[@]+"${REVIEWER_ARGS[@]}"} --policy "$POLICY" --k "$K"
        --seed "$SEED" --force-rerun)
  [ -n "$ARM_ATTACK" ] && ARGS+=(--attack "$ARM_ATTACK")
  # shellcheck disable=SC2086
  [ -n "$INJ" ] && ARGS+=(--injection-tasks $INJ)
  # shellcheck disable=SC2086
  [ -n "$USER_TASKS" ] && ARGS+=(--user-tasks $USER_TASKS)
  # shellcheck disable=SC2086
  [ -n "$EXTRA" ] && ARGS+=($EXTRA)
  echo "starting $NAME"
  .venv/bin/python scripts/run_benchmark.py "${ARGS[@]}" > "$LOGDIR/${NAME}_$JOB.log" 2>&1 &
  PIDS+=($!)
  NAMES+=("$NAME")
done

FAILED=0
for i in "${!PIDS[@]}"; do
  if wait "${PIDS[$i]}"; then
    echo "done ${NAMES[$i]}"
    tail -4 "$LOGDIR/${NAMES[$i]}_$JOB.log"
  else
    echo "FAILED ${NAMES[$i]}, see $LOGDIR/${NAMES[$i]}_$JOB.log"
    tail -15 "$LOGDIR/${NAMES[$i]}_$JOB.log"
    FAILED=1
  fi
done
exit $FAILED
