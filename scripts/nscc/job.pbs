#!/bin/bash
#PBS -N egate
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -uo pipefail
cd "$PBS_O_WORKDIR" || exit 1

MODEL="${MODEL:-cyankiwi/Qwen3.8-27B-AWQ-INT4}"
ARMS="${ARMS:-full_approve:inf full_escalate:0 full_escalate:1 full_escalate:3 full_escalate:inf cascade:0 cascade:1 cascade:3 cascade:inf}"
ATTACK="${ATTACK:-}"
INJ="${INJ:-}"
USER_TASKS="${USER_TASKS:-}"
SEED="${SEED:-0}"
EXTRA="${EXTRA:-}"
SCRATCH_DIR="${SCRATCH_DIR:-/scratch/users/ntu/jonatha4}"

export PATH="$HOME/vllm-env/bin:$PATH"
export HF_HOME="$SCRATCH_DIR/hf"
export HF_HUB_OFFLINE=1
export VLLM_USE_FLASHINFER_SAMPLER=0
export OPENAI_BASE_URL=http://localhost:8000/v1
export OPENAI_API_KEY=EMPTY

JOB="${PBS_JOBID%%.*}"
LOGDIR=results/nscc
mkdir -p "$LOGDIR"
VLLM_LOG="$LOGDIR/vllm_$JOB.log"

echo "job $JOB on $(hostname), model $MODEL"
echo "arms: $ARMS"
echo "attack: ${ATTACK:-none}  injection tasks: ${INJ:-all}  user tasks: ${USER_TASKS:-all}"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader

vllm serve "$MODEL" \
  --max-model-len 16384 \
  --max-num-seqs 32 \
  --limit-mm-per-prompt '{"image":0,"video":0}' \
  --gpu-memory-utilization 0.92 \
  --seed 0 \
  --reasoning-parser qwen3 \
  --enable-auto-tool-choice --tool-call-parser qwen3_xml \
  > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!
trap 'kill "$VLLM_PID" 2>/dev/null' EXIT

for _ in $(seq 1 180); do
  curl -sf localhost:8000/v1/models > /dev/null && break
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then
    echo "vLLM exited during startup"; tail -40 "$VLLM_LOG"; exit 1
  fi
  sleep 10
done
if ! curl -sf localhost:8000/v1/models > /dev/null; then
  echo "vLLM not ready"; tail -40 "$VLLM_LOG"; exit 1
fi
echo "vLLM ready"

if ! .venv/bin/python -c "
import openai
m = openai.OpenAI().chat.completions.create(model='$MODEL', messages=[{'role':'user','content':'say ok'}], max_tokens=20)
print('probe:', repr(m.choices[0].message.content))
"; then
  echo "probe request failed"; tail -20 "$VLLM_LOG"; exit 1
fi

PIDS=()
NAMES=()
for ARM in $ARMS; do
  POLICY="${ARM%%:*}"
  REST="${ARM#*:}"
  K="${REST%%:*}"
  ARM_ATTACK="$ATTACK"
  [[ "$REST" == *:* ]] && ARM_ATTACK="${REST#*:}"
  NAME="${POLICY}_k${K}_s${SEED}${ARM_ATTACK:+_$ARM_ATTACK}"
  ARGS=(--model "$MODEL" --policy "$POLICY" --k "$K" --seed "$SEED" --force-rerun)
  [ -n "$ARM_ATTACK" ] && ARGS+=(--attack "$ARM_ATTACK")
  # shellcheck disable=SC2086
  [ -n "$INJ" ] && ARGS+=(--injection-tasks $INJ)
  # shellcheck disable=SC2086
  [ -n "$USER_TASKS" ] && ARGS+=(--user-tasks $USER_TASKS)
  # shellcheck disable=SC2086
  [ -n "$EXTRA" ] && ARGS+=($EXTRA)
  echo "starting $NAME"
  .venv/bin/python scripts/run_benchmark.py "${ARGS[@]}" > "$LOGDIR/${NAME}_$JOB.log" 2>&1 &
  PIDS+=($!)
  NAMES+=("$NAME")
done

FAILED=0
for i in "${!PIDS[@]}"; do
  if wait "${PIDS[$i]}"; then
    echo "done ${NAMES[$i]}"
    tail -4 "$LOGDIR/${NAMES[$i]}_$JOB.log"
  else
    echo "FAILED ${NAMES[$i]}, see $LOGDIR/${NAMES[$i]}_$JOB.log"
    tail -15 "$LOGDIR/${NAMES[$i]}_$JOB.log"
    FAILED=1
  fi
done
exit $FAILED
