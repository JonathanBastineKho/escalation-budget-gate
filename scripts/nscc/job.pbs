#!/bin/bash
#PBS -N egate
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -uo pipefail
if [[ -z "${PBS_JOBID:-}" || -z "${PBS_O_WORKDIR:-}" ]]; then
  echo "Submit from the repository directory with: qsub scripts/nscc/job.pbs"
  exit 1
fi
cd "$PBS_O_WORKDIR" || exit 1

# Python's module swaps an already-loaded GCC module, so load GCC first.
module load gcc/11.4.0-nscc || exit 1
module load python/3.11.7-gcc11 || exit 1

MODEL="${MODEL:-cyankiwi/Qwen3.8-27B-AWQ-INT4}"
REVIEWER_MODEL="${REVIEWER_MODEL:-$MODEL}"
REVIEWER_MEM="${REVIEWER_MEM:-0.57}"
AGENT_MEM="${AGENT_MEM:-0.37}"
# Default: six attacked cases (three policies x two tasks x one injection).
# Pass overrides with qsub -v. Explicit empty ATTACK means clean tasks;
# explicit empty INJ or USER_TASKS means all tasks of that kind.
ARMS="${ARMS:-cascade:1 task_scoped:1 task_scoped_budget:1}"
ATTACK="${ATTACK-important_instructions_generic}"
INJ="${INJ-injection_task_0}"
USER_TASKS="${USER_TASKS-user_task_0 user_task_1}"
SUITE="${SUITE:-banking}"
SEED="${SEED:-0}"
EXTRA="${EXTRA:-}"
SCRATCH_DIR="${SCRATCH_DIR:-/scratch/users/ntu/tejasvit}"
VLLM_ENV="${VLLM_ENV:-$SCRATCH_DIR/venvs/vllm-env}"
BENCH_PYTHON="$PBS_O_WORKDIR/.venv/bin/python"

if [[ ! -d "$SCRATCH_DIR" ]]; then
  echo "Scratch directory does not exist: $SCRATCH_DIR"
  exit 1
fi
if [[ ! -x "$BENCH_PYTHON" ]]; then
  echo "Missing $BENCH_PYTHON; create the project's Python 3.11+ virtual environment first."
  exit 1
fi
if [[ ! -r "$PBS_O_WORKDIR/.venv/bin/activate" ]]; then
  echo "Missing benchmark activation script: $PBS_O_WORKDIR/.venv/bin/activate"
  exit 1
fi
source "$PBS_O_WORKDIR/.venv/bin/activate" || exit 1
echo "Benchmark environment activated: $VIRTUAL_ENV"
echo "Benchmark Python: $(command -v python)"

if [[ ! -x "$VLLM_ENV/bin/vllm" ]]; then
  echo "Missing $VLLM_ENV/bin/vllm. Set VLLM_ENV to your working vLLM environment."
  echo "Example: export VLLM_ENV=/path/to/environment; qsub -v VLLM_ENV scripts/nscc/job.pbs"
  exit 1
fi
if [[ ! -r "$VLLM_ENV/bin/activate" ]]; then
  echo "Missing vLLM activation script: $VLLM_ENV/bin/activate"
  echo "VLLM_ENV must point to the Python virtual environment used for vLLM."
  exit 1
fi
if ! "$BENCH_PYTHON" -c 'import sys; assert sys.version_info >= (3, 11); import approval_gate.policies.task_scoped, agentdojo, openai'; then
  echo "Benchmark environment is incomplete; install the project into .venv with Python 3.11+."
  exit 1
fi

export MODEL REVIEWER_MODEL
export HF_HOME="${HF_HOME:-$SCRATCH_DIR/hf}"
export HF_HUB_OFFLINE=1
export VLLM_USE_FLASHINFER_SAMPLER=0
export OPENAI_BASE_URL=http://localhost:8000/v1
export OPENAI_API_KEY=EMPTY
if [[ ! -d "$HF_HOME/hub" && ! -d "$MODEL" ]]; then
  echo "No model cache found at $HF_HOME/hub. Download the model there before submitting,"
  echo "or pass HF_HOME pointing to your existing cache. This job uses offline mode."
  exit 1
fi

JOB="${PBS_JOBID%%.*}"
LOGDIR=results/nscc
mkdir -p "$LOGDIR"

echo "job $JOB on $(hostname), agent $MODEL, reviewer $REVIEWER_MODEL"
echo "arms: $ARMS"
echo "attack: ${ATTACK:-none}  injection tasks: ${INJ:-all}  user tasks: ${USER_TASKS:-all}"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader

serve() {  # model port memory-share log
  local parser=qwen3_xml
  [[ "$1" == *Qwen3.5* ]] && parser=qwen3_coder
  (
    source "$VLLM_ENV/bin/activate" || exit 1
    exec "$VLLM_ENV/bin/vllm" serve "$1" \
    --port "$2" \
    --max-model-len 32768 \
    --max-num-seqs 32 \
    --limit-mm-per-prompt '{"image":0,"video":0}' \
    --gpu-memory-utilization "$3" \
    --seed 0 \
    --reasoning-parser qwen3 \
    --enable-auto-tool-choice --tool-call-parser "$parser" \
  ) > "$4" 2>&1 &
  LAST_PID=$!
  SERVER_PIDS+=("$LAST_PID")
}

wait_ready() {  # port log
  for _ in $(seq 1 180); do
    curl -sf "localhost:$1/v1/models" > /dev/null && return 0
    if ! kill -0 "$LAST_PID" 2>/dev/null; then
      echo "vLLM on port $1 exited during startup"; tail -40 "$2"; return 1
    fi
    sleep 10
  done
  echo "vLLM on port $1 not ready"; tail -40 "$2"; return 1
}

SERVER_PIDS=()
trap 'kill "${SERVER_PIDS[@]}" 2>/dev/null' EXIT
REVIEWER_ARGS=()
unset REVIEWER_BASE_URL
# Replay needs only one server: MODEL is the reviewer being tested.
if [[ -n "${REPLAY_CASES:-}" ]]; then
  REVIEWER_MODEL="$MODEL"
fi
if [ "$REVIEWER_MODEL" = "$MODEL" ]; then
  serve "$MODEL" 8000 0.92 "$LOGDIR/vllm_$JOB.log"
  wait_ready 8000 "$LOGDIR/vllm_$JOB.log" || exit 1
else
  serve "$REVIEWER_MODEL" 8001 "$REVIEWER_MEM" "$LOGDIR/vllm_reviewer_$JOB.log"
  wait_ready 8001 "$LOGDIR/vllm_reviewer_$JOB.log" || exit 1
  serve "$MODEL" 8000 "$AGENT_MEM" "$LOGDIR/vllm_agent_$JOB.log"
  wait_ready 8000 "$LOGDIR/vllm_agent_$JOB.log" || exit 1
  export REVIEWER_BASE_URL=http://localhost:8001/v1
  REVIEWER_ARGS=(--reviewer-model "$REVIEWER_MODEL")
fi
echo "vLLM ready"
grep -h "KV cache" "$LOGDIR"/vllm*_"$JOB".log | tail -4

if ! "$BENCH_PYTHON" -c '
import os, openai
for url, model in {(os.environ["OPENAI_BASE_URL"], os.environ["MODEL"]),
                   (os.environ.get("REVIEWER_BASE_URL", os.environ["OPENAI_BASE_URL"]),
                    os.environ["REVIEWER_MODEL"])}:
    m = openai.OpenAI(base_url=url).chat.completions.create(
        model=model, messages=[{"role": "user", "content": "say ok"}], max_tokens=20)
    print("probe", model, repr(m.choices[0].message.content))
'; then
  echo "probe request failed"; exit 1
fi

# Optional reviewer-only experiment: replay saved contexts, execute no agent tools.
# Pass REPLAY_CASES=tests/fixtures/reviewer_task_scope.jsonl with qsub -v.
if [[ -n "${REPLAY_CASES:-}" ]]; then
  echo "Replaying legacy and task-scoped reviewers on $REPLAY_CASES"
  "$BENCH_PYTHON" scripts/replay_reviewer.py \
    --cases "$REPLAY_CASES" --suite "$SUITE" --model "$MODEL" --seed "$SEED" \
    --output "$LOGDIR/reviewer_replay_$JOB.jsonl"
  exit $?
fi

PIDS=()
NAMES=()
for ARM in $ARMS; do
  POLICY="${ARM%%:*}"
  REST="${ARM#*:}"
  K="${REST%%:*}"
  ARM_ATTACK="$ATTACK"
  [[ "$REST" == *:* ]] && ARM_ATTACK="${REST#*:}"
  NAME="${POLICY}_k${K}_s${SEED}${ARM_ATTACK:+_$ARM_ATTACK}"
  ARGS=(--model "$MODEL" ${REVIEWER_ARGS[@]+"${REVIEWER_ARGS[@]}"} --suite "$SUITE" --policy "$POLICY" --k "$K"
        --seed "$SEED" --force-rerun)
  [ -n "$ARM_ATTACK" ] && ARGS+=(--attack "$ARM_ATTACK")
  # shellcheck disable=SC2086
  [ -n "$INJ" ] && ARGS+=(--injection-tasks $INJ)
  # shellcheck disable=SC2086
  [ -n "$USER_TASKS" ] && ARGS+=(--user-tasks $USER_TASKS)
  # shellcheck disable=SC2086
  [ -n "$EXTRA" ] && ARGS+=($EXTRA)
  echo "starting $NAME"
  "$BENCH_PYTHON" scripts/run_benchmark.py "${ARGS[@]}" > "$LOGDIR/${NAME}_$JOB.log" 2>&1 &
  PIDS+=($!)
  NAMES+=("$NAME")
done

FAILED=0
for i in "${!PIDS[@]}"; do
  if wait "${PIDS[$i]}"; then
    echo "done ${NAMES[$i]}"
    tail -4 "$LOGDIR/${NAMES[$i]}_$JOB.log"
  else
    echo "FAILED ${NAMES[$i]}, see $LOGDIR/${NAMES[$i]}_$JOB.log"
    tail -15 "$LOGDIR/${NAMES[$i]}_$JOB.log"
    FAILED=1
  fi
done
exit $FAILED
