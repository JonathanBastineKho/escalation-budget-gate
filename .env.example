# OpenRouter
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Local vLLM on the NTU cluster (vLLM ignores the key, but the client requires one)
# OPENAI_API_KEY=dummy
# OPENAI_BASE_URL=http://localhost:8000/v1

# Telegram progress notifications: configure your bot and destination chat.
# auto = estimated jobs >=1 hour; on = all supported jobs; off = disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_ID=
TELEGRAM_NOTIFICATIONS=auto
